# ComponentAimingSights: desktop crosshair instead of the mobile aiming "sights".
#
# While aiming (throwables, bow, crossbow, musket) the game draws
# Textures/Gui/Sights as a world-space quad placed from the aim ray that
# ComponentInput captured early in the frame, i.e. before the camera applied
# that frame's rotation. With a mouse the reticle therefore wobbles relative to
# the view while turning. With mouse/keyboard input keep the plain crosshair
# (also no longer suppressed while aiming) and leave the sights to touch input.
#
--- a/decompiled/src/Survivalcraft/Game/ComponentAimingSights.cs
+++ b/decompiled/src/Survivalcraft/Game/ComponentAimingSights.cs
@@ -45,7 +45,11 @@
 		}
