# Survivalcraft 2 — Linux port build & install
#
# Cycle:
#   ./install.sh <apk>     one-shot: compile + build + install + drop build/
#   ./compile <apk>       unpack the original APK, decompile, patch (and build)
#   make clean            wipe build outputs (and the pipeline work dir)
#   make                  build (same as: make build)
#   (sudo) make install   publish + place binary + desktop shortcut (all of it)
#   (sudo) make uninstall remove everything installed
#   make distclean        back to a patcher-only tree (drop all APK products)
#
# Every build artifact lives in build/ (obj, bin, publish, pipeline work dir,
# tmp - Directory.Build.props redirects dotnet there), so `make clean` is a
# single rm -rf build; TMPDIR of the whole build is build/tmp.
#
# The repository holds the patcher only: decompiled sources, the managed
# assemblies taken from the APK and the launcher icon are generated by
# ./compile and are not tracked (see README.md).
#
# Re-derive everything from the original Android APK (see ./compile):
#   make from-apk APK=/path/to/survivalcraft.apk [ARGS=--fixes]
#
# Optional patch layers on top of the 1:1 port:
#   make fixes            apply patches/fixes (desktop behaviour) and rebuild
#   make unfixes          revert them and rebuild
#
# install without sudo → everything under ~/.local + ~/.config/survivalcraft2
# install with sudo     → binary/app under /usr/local, desktop entry + config
#                         still in the invoking user's home (SUDO_USER)
#
# Installed paths:
#   launcher   $PREFIX/bin/survivalcraft2        (PREFIX=~/.local or /usr/local)
#   app files  $PREFIX/lib/survivalcraft2
#   config     ~/.config/survivalcraft2          (settings, saves, downloads)
#   desktop    ~/.local/share/applications/survivalcraft2.desktop  (user only)
#   icon       ~/.local/share/icons/hicolor/144x144/apps/survivalcraft2.png

CONFIG        ?= Release
BUILD_DIR     := build
TMP_DIR       := $(BUILD_DIR)/tmp
PUBLISH_DIR   ?= $(BUILD_DIR)/publish
PROJECT       := port/Survivalcraft.Linux/Survivalcraft.Linux.csproj
INSTALL_SH    := install/install.sh
APK           ?=
ARGS          ?=

.PHONY: build install uninstall clean distclean fixes unfixes from-apk scratch

# Everything the build writes lands in build/ (obj, bin, publish, tmp):
# Directory.Build.props redirects the dotnet intermediate/output paths there.
scratch:
	@mkdir -p $(TMP_DIR)

build: scratch
	@test -d decompiled/src/Engine && test -d decompiled/src/Survivalcraft \
		&& test -f port/lib/EntitySystem.Android.Net.dll \
		&& test -f port/lib/_Microsoft.Android.Resource.Designer.dll \
		|| { echo "error: no decompiled sources in the tree — run ./compile <survivalcraft.apk> first"; exit 1; }
	TMPDIR="$(CURDIR)/$(TMP_DIR)" dotnet build $(PROJECT) -c $(CONFIG) --nologo

# Apply/revert the optional behaviour-fix layer on the decompiled tree, then rebuild.
fixes:
	tools/patch-stages.sh apply fixes
	$(MAKE) build

unfixes:
	tools/patch-stages.sh revert fixes
	$(MAKE) build

# Full re-derivation from the original Android APK (decompile + patch + build).
from-apk:
	@test -n "$(APK)" || { echo "usage: make from-apk APK=/path/to/survivalcraft.apk [ARGS=--fixes]"; exit 1; }
	./compile $(ARGS) "$(APK)"

install: scratch
	TMPDIR="$(CURDIR)/$(TMP_DIR)" dotnet publish $(PROJECT) -c $(CONFIG) -o $(PUBLISH_DIR) --nologo
	@if [ "`id -u`" = 0 ] && [ -n "$$SUDO_USER" ]; then \
		chown -R "$$SUDO_USER" "$(CURDIR)/$(BUILD_DIR)"; \
	fi
	PUBLISH_DIR="$(abspath $(PUBLISH_DIR))" $(INSTALL_SH)

uninstall:
	PUBLISH_DIR="$(abspath $(PUBLISH_DIR))" $(INSTALL_SH) --uninstall

# drop every build artifact (obj/bin/publish/tmp + the pipeline's own scratch)
clean:
	rm -rf $(CURDIR)/$(BUILD_DIR) $(CURDIR)/publish \
		port/Engine.Linux/bin port/Engine.Linux/obj \
		port/Survivalcraft.Linux/bin port/Survivalcraft.Linux/obj

# back to a patcher-only tree: also drop everything ./compile generated from the APK
distclean: clean
	rm -rf decompiled port/lib install/survivalcraft2.png
